# Unity serializes text assets with LF; keep them that way on Windows so
# diffs stay clean regardless of core.autocrlf.
* text=auto eol=lf

*.cs        text eol=lf diff=csharp
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.asmdef    text eol=lf
*.inputactions text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.sql       text eol=lf

*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
