{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bölüm ajanı kartı",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bolum_no",
    "tip",
    "sure_sn",
    "fikir",
    "anahtar",
    "perde1",
    "perde2",
    "perde3",
    "final",
    "yeni_oge",
    "sekil_notu",
    "beklenen_oyuncu",
    "ilk3_min_secenek",
    "en_uzun_bogaz_min",
    "en_uzun_bogaz_max",
    "bogaz_sayisi_min",
    "bomba_tehdit_adimi_max",
    "bomba_fitil_max",
    "tuzak_adim_min",
    "cig_orani_min",
    "bomba_unutan_kaybetmeli",
    "kalan_sure_orani",
    "tarif"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "bolum_no": {
      "type": "integer",
      "minimum": 1
    },
    "tip": {
      "enum": [
        "tanitim",
        "normal",
        "nefes",
        "zor",
        "super-zor"
      ]
    },
    "sure_sn": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600
    },
    "fikir": {
      "type": "string",
      "minLength": 1
    },
    "anahtar": {
      "type": "string",
      "minLength": 1
    },
    "perde1": {
      "type": "string",
      "minLength": 1
    },
    "perde2": {
      "type": "string",
      "minLength": 1
    },
    "perde3": {
      "type": "string",
      "minLength": 1
    },
    "final": {
      "type": "string",
      "minLength": 1
    },
    "yeni_oge": {
      "type": "string",
      "minLength": 1
    },
    "sekil_notu": {
      "type": "string",
      "minLength": 1
    },
    "beklenen_oyuncu": {
      "type": "string",
      "minLength": 1
    },
    "ilk3_min_secenek": {
      "type": "integer",
      "minimum": 0
    },
    "en_uzun_bogaz_min": {
      "type": "integer",
      "minimum": 0
    },
    "en_uzun_bogaz_max": {
      "type": "integer",
      "minimum": 0
    },
    "bogaz_sayisi_min": {
      "type": "integer",
      "minimum": 0
    },
    "bomba_tehdit_adimi_max": {
      "type": "integer",
      "minimum": 0
    },
    "bomba_fitil_max": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "enum": [
            "earliest+2"
          ]
        }
      ]
    },
    "tuzak_adim_min": {
      "type": "integer",
      "minimum": 0
    },
    "cig_orani_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bomba_unutan_kaybetmeli": {
      "type": "boolean"
    },
    "kalan_sure_orani": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "tarif": {
      "$ref": "#/definitions/recipe"
    },
    "funsim_ilk_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bomba_fitil_min": {
      "enum": [
        "earliest+4"
      ]
    }
  },
  "definitions": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "w": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "h": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "seals": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "chains": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "nails": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "genre": {
          "enum": [
            "tanitim",
            "normal",
            "nefes",
            "zor",
            "super-zor",
            "orta",
            "cokzor"
          ]
        },
        "timer": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "bombs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "earliest",
              "margin"
            ],
            "properties": {
              "earliest": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "margin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 98
              },
              "region": {
                "enum": [
                  "any",
                  "top",
                  "bottom",
                  "left",
                  "right",
                  "center"
                ]
              }
            }
          }
        },
        "seed_from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "seed_to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26
        },
        "min_open_first": {
          "type": "integer",
          "minimum": 1
        },
        "intro": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "tip": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "bintro": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "tip": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            }
          }
        }
      },
      "required": [
        "id",
        "seals",
        "chains",
        "nails",
        "genre",
        "timer",
        "bombs",
        "seed_from",
        "seed_to",
        "count",
        "min_open_first"
      ]
    }
  }
}
